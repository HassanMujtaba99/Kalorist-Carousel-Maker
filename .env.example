# Required for the login/accounts feature. A Postgres connection string —
# Neon (neon.tech) is the intended provider: run `npx neonctl@latest init`
# (or create a project at console.neon.tech) and paste the connection
# string it gives you here.
DATABASE_URL=

# Required for the login/accounts feature. Generate with:
#   openssl rand -base64 32
# Encrypts saved API keys at rest in the database. Changing this after
# accounts have saved settings makes their encrypted keys unreadable.
ENCRYPTION_KEY=

# Required for the login/accounts feature. Sign-in/sign-up is powered by
# Neon's Managed Better Auth. Enable it in the Neon Console for your project
# (Project -> Auth tab -> Enable), then copy the Auth URL from the
# Configuration tab.
NEON_AUTH_BASE_URL=

# Required alongside NEON_AUTH_BASE_URL. Generate with:
#   openssl rand -base64 32
# Must be at least 32 characters — signs the session cache cookie.
NEON_AUTH_COOKIE_SECRET=

# Google sign-in works out of the box once Auth methods -> Google is
# enabled in the Neon Auth dashboard. Apple sign-in requires your own Apple
# Developer Program account (Services ID, Team ID, Key ID, private key)
# configured there too — this is an Apple platform requirement, not
# optional tooling.
