# Required for the login/accounts feature. Generate with:
#   openssl rand -base64 32
# Encrypts saved API keys at rest in the database. Changing this after
# accounts have saved settings makes their encrypted keys unreadable.
ENCRYPTION_KEY=

# Optional. Where the SQLite database file lives. Defaults to ./data/app.db.
# NOTE: this needs a persistent, writable filesystem — fine for self-hosting
# (Docker/VPS/PM2), but NOT for stateless serverless platforms like Vercel,
# where local disk is ephemeral. Point this at a mounted volume there, or
# swap src/lib/server/db.ts for a hosted database.
# DATABASE_PATH=./data/app.db
