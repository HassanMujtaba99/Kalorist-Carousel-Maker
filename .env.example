# Required for the login/accounts feature. A Postgres connection string —
# Neon (neon.tech) is the intended provider: run `npx neonctl@latest init`
# (or create a project at console.neon.tech) and paste the connection
# string it gives you here.
DATABASE_URL=

# Required for the login/accounts feature. Generate with:
#   openssl rand -base64 32
# Encrypts saved API keys at rest in the database. Changing this after
# accounts have saved settings makes their encrypted keys unreadable.
ENCRYPTION_KEY=

# Required for the login/accounts feature. Sign-in/sign-up is powered by
# Neon Auth (built on Stack Auth). Enable it in the Neon Console for your
# project (Project -> Auth tab -> Enable) — it provisions these three
# values automatically; copy them from there.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Google sign-in works immediately with no extra setup (Stack Auth provides
# shared dev OAuth keys). Apple sign-in requires your own Apple Developer
# Program account (Services ID, Team ID, Key ID, private key) configured in
# the Neon Auth / Stack Auth dashboard under Auth methods -> OAuth providers
# -> Apple — this is an Apple platform requirement, not optional tooling.
